<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <title>Profil Pegawai - Enterprise</title>
    <link rel="stylesheet" href="/css/main.css">
</head>
<body>
    <div class="container">
        <h2>👤 Detail Profil Pegawai</h2>
        <% if (!isOwner) { %>
            <div style="background: #713f12; color: #fef08a; padding: 10px; margin-bottom: 15px;">
                ⚠️ <b>Peringatan IDOR:</b> Anda sedang melihat profil pegawai lain melalui manipulasi parameter URL!
            </div>
        <% } %>
        <div class="card">
            <p><b>ID Pegawai:</b> <%= profileUser.id %></p>
            <p><b>Username:</b> <%= profileUser.username %></p>
            <p><b>Departemen:</b> <%= profileUser.department %></p>
            <p><b>Jabatan / Role:</b> <%= profileUser.role %></p>
            <p><b>Gaji Rahasia:</b> <span style="color: #4ade80;">$<%= profileUser.salary.toLocaleString() %></span></p>
        </div>
        <br>
        <a href="/dashboard"><< Kembali ke Dashboard</a>
    </div>
</body>
</html>
